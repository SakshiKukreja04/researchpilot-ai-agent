# ResearchPilot Environment Configuration
# Copy this file to .env and replace placeholders with your actual settings.
# NEVER commit .env to source control!

# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model available on your free tier (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=gpt-os

# Application Environment (development, testing, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Execution Budgets & Timeouts
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_OUTPUT_TOKENS=2048
MAX_SEARCH_QUERIES=5
MAX_FETCH_PAGES=8
MAX_RESEARCH_ROUNDS=1
OVERALL_DEADLINE_SECONDS=90.0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=128
SEARCH_FALLBACK_BACKEND=bing
STREAMLIT_EVALUATION_LOG=evaluation/results/streamlit_runs.json
